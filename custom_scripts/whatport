def fallback_search(query):
    found = False
    is_num = query.isdigit()
    query_lower = query.lower()
    
    # 1. Check Nmap services (Homebrew path)
    nmap_path = "/opt/homebrew/share/nmap/nmap-services"
    if os.path.exists(nmap_path):
        try:
            if is_num:
                cmd = f"grep -E -w '^{query}/(tcp|udp)' {nmap_path}"
            else:
                cmd = f"grep -i -E '^{query}\\s+' {nmap_path}"
                
            result = subprocess.check_output(cmd, shell=True, text=True).strip()
            if result:
                print(f"\n{C}[+] Nmap Database Match:{E}")
                # Limit to first 10 matches to avoid flooding
                lines = result.split('\n')[:10]
                for line in lines:
                    if line.startswith('#'): continue
                    parts = line.split()
                    if len(parts) >= 3:
                        print(f"    {B}Service:{E} {parts[0].ljust(15)} {B}Proto:{E} {parts[1].ljust(10)} {B}Info:{E} {' '.join(parts[3:])}")
                if len(result.split('\n')) > 10:
                    print(f"    {Y}... (showing first 10 results){E}")
                found = True
        except subprocess.CalledProcessError:
            pass

    # 2. Check /etc/services
    if not found:
        try:
            if is_num:
                cmd = f"awk '$2 ~ /^{query}\\//' /etc/services"
            else:
                cmd = f"grep -i -E '^{query}\\s+' /etc/services"
                
            result = subprocess.check_output(cmd, shell=True, text=True).strip()
            if result:
                print(f"\n{C}[+] OS /etc/services Match:{E}")
                lines = result.split('\n')[:10]
                for line in lines:
                    if not line.startswith('#'):
                        parts = line.split()
                        if len(parts) >= 2:
                            desc = ' '.join(parts[2:]) if len(parts) > 2 else ""
                            print(f"    {B}Service:{E} {parts[0].ljust(15)} {B}Port:{E} {parts[1].ljust(10)} {desc}")
                if len(result.split('\n')) > 10:
                    print(f"    {Y}... (showing first 10 results){E}")
                found = True
        except subprocess.CalledProcessError:
            pass
            
    if not found:
        print(f"\n{R}[-] '{query}' not found in any database.{E}")

