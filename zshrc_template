# Subbrute requires running from its own folder to find resolvers.txt
subbrute() {
    local new_args=()
    local prev_arg=""
    
    for arg in "$@"; do
        # 1. If the file already exists locally, expand it
        if [[ -e "$arg" && "$arg" != /* ]]; then
            arg="$PWD/${arg#./}"
            
        # 2. If it doesn't exist yet, but it's an output file (follows the -o flag), expand it!
        elif [[ "$prev_arg" == "-o" && "$arg" != /* ]]; then
            arg="$PWD/${arg#./}"
        fi
        
        prev_arg="$arg"
        new_args+=("$arg")
    done
    (cd "$TOOLS_DIR/subbrute" && python3.10 subbrute.py "${new_args[@]}")
}

