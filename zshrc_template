# xfreerdp automated for terminal
# Auto starts XQuartz, sets DISPLAY, and bypasses certs
xfreerdp() {
      if [ "$#" -eq 0 ]; then
        command xfreerdp
        return
      fi

      if pgrep -f "XQuartz" > /dev/null; then
        : # XQuartz is already running
      else
        brew reinstall --cask --quiet xquartz > /dev/null
        open -a XQuartz
        sleep 1
      fi

      export DISPLAY=:0

      command xfreerdp \
        /drive:"$USER",$PWD \
        /cert:ignore \
        /dynamic-resolution \
        +clipboard \
        +auto-reconnect \
        "$@"
}



