# Metasploit Native DB Wrapper
msfconsole() {
    local status=$(msfdb status 2>/dev/null)
    if echo "$status" | grep -q "Database found, but is not running"; then
        echo "[*] Waking up Metasploit Postgres database..."
        msfdb start >/dev/null 2>&1
    elif ! echo "$status" | grep -q "Database started"; then
        # If it's not started and not just "not running", try to init it
        echo "[*] Initializing Metasploit Postgres database..."
        msfdb init >/dev/null 2>&1
    fi
    command msfconsole "$@"
}

