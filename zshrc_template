# macOS Quarantine Management
unquarantine() {
    if [ -z "$1" ]; then
        echo "Usage: unquarantine <App_Name> (e.g., unquarantine Chromium)"
        return 1
    fi

    local app_path="$1"
    
    # Auto-complete the path if only the name is provided
    if [[ ! "$app_path" == /* ]]; then
        app_path="/Applications/$app_path"
    fi
    if [[ ! "$app_path" == *.app* ]]; then
        app_path="${app_path}.app"
    fi

    if [ ! -d "$app_path" ]; then
        echo "[-] App not found: $app_path"
        return 1
    fi

    sudo xattr -r -d com.apple.quarantine "$app_path" 2>/dev/null
    echo "[+] Quarantine removed from $app_path"
}

scan-quarantine() {
    echo "[*] Scanning /Applications for quarantined apps..."
    for app in /Applications/*.app; do
        if xattr "$app" 2>/dev/null | grep -q "com.apple.quarantine"; then
            echo "[!] Flagged: $app"
        fi
    done
}

# System Update (Debian's apt update && apt upgrade equivalent)
sysupdate() {
    echo "Hit:1 https://brew.sh/packages macos-rolling InRelease"
    echo "Hit:2 https://pypi.org/simple pipx-tools InRelease"
    echo "Hit:3 https://github.com/ repos InRelease"
    sleep 1
    echo "Reading package lists... Done"
    echo "Building dependency tree... Done"
    echo "Reading state information... Done"
    sleep 1
    echo "Calculating upgrade... Done\n"

    brew update && brew upgrade && brew cleanup
    
    echo "\n"

    pipx upgrade-all

    echo "\n"

    for d in "$TOOLS_DIR"/*/; do
        if [ -d "$d/.git" ]; then
            # Print which folder is being checked so we know if iCloud hangs
            printf "Chk: %-30s\r" "$(basename "$d")"
            
            # Fetch silently with a 60-second timeout to prevent infinite iCloud hangs
            export GIT_TERMINAL_PROMPT=0
            if ! perl -e 'alarm 60; exec @ARGV' git -C "$d" fetch -q 2>/dev/null; then
                printf "%-35s\r" " "
                echo "E: Skipped $(basename "$d") (Timeout/iCloud stall)"
                continue
            fi
            
            # Check how many commits we are behind the remote
            BEHIND=$(git -C "$d" rev-list HEAD..@{u} --count 2>/dev/null || echo "0")
            
            # Clear the checking line
            printf "%-35s\r" " "
            
            if [ "$BEHIND" -eq 0 ]; then
                echo "Hit: $(basename "$d") (Up to date)"
            else
                if ! git -C "$d" diff --quiet || ! git -C "$d" diff --cached --quiet; then
                    echo "W: Updates available for $(basename "$d") but skipped (Local changes detected)"
                else
                    echo "Get: $(basename "$d")..."
                    if perl -e 'alarm 120; exec @ARGV' git -C "$d" pull -q; then
                        echo "I: $(basename "$d") updated successfully"
                    else
                        echo "E: Failed to update $(basename "$d") (Timeout)"
                    fi
                fi
            fi
        fi
    done
    echo "\nDone."
}

