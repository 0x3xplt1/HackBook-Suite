# Kali Linux Docker Container
kali-linux-lab() {
    local rm_flag="--rm"
    local new_args=()
    
    # Parse for --persist flag
    for arg in "$@"; do
        if [[ "$arg" == "--persist" ]]; then
            rm_flag=""
        else
            new_args+=("$arg")
        fi
    done

    docker run --name kali-linux-lab --hostname kali $rm_flag -it \
      --cap-add=NET_ADMIN \
      --device /dev/net/tun \
      -p 5901:5901 \
      -p 5900:5900 \
      -v ~/DockerLabs/docker-shared-data:/root/shared \
      0x3xplt1/kali-linux-lab:latest "${new_args[@]}"
}

