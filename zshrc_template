cyberchef() {
    LOCAL_FILE=$(ls "$HOME/Documents/Tools/CyberChef"/CyberChef_v*.html 2>/dev/null | head -n 1)
    if [ -n "$LOCAL_FILE" ]; then
        LOCAL_VER=$(basename "$LOCAL_FILE" | sed -n 's/CyberChef_\(v.*\)\.html/\1/p')
    else
        LOCAL_VER="None"
    fi
    REMOTE_VER=$(curl -s --max-time 2 https://api.github.com/repos/gchq/CyberChef/releases/latest | grep '"tag_name":' | awk -F'"' '{print $4}')
    if [ -n "$REMOTE_VER" ] && [ "$LOCAL_VER" != "$REMOTE_VER" ]; then
        echo "[!] New CyberChef version found: $REMOTE_VER (Local: $LOCAL_VER)"
        printf "Update now? [y/N]: "
        read response
        if [[ "$response" =~ ^[Yy]$ ]]; then
            echo "[*] Downloading $REMOTE_VER..."
            LATEST_URL=$(curl -s https://api.github.com/repos/gchq/CyberChef/releases/latest | grep "browser_download_url.*\.zip" | awk -F'"' '{print $4}')
            if [ -n "$LATEST_URL" ]; then
                mkdir -p "$HOME/Documents/Tools/CyberChef"
                rm -f "$HOME/Documents/Tools/CyberChef"/CyberChef_v*.html
                curl -sL "$LATEST_URL" -o /tmp/CyberChef.zip
                unzip -o -q /tmp/CyberChef.zip -d "$HOME/Documents/Tools/CyberChef/"
                rm /tmp/CyberChef.zip
                echo "[+] Update complete!"
            fi
        fi
    fi
    open "$HOME/Documents/Tools/CyberChef"/CyberChef_v*.html 2>/dev/null || echo "[-] CyberChef file not found!"
}
